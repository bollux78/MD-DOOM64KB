diff -ruN a/src/r64_diag.h b/src/r64_diag.h
--- a/src/r64_diag.h	1970-01-01 00:00:00.000000000 +0000
+++ b/src/r64_diag.h	2026-10-25 16:31:54.407710942 +0000
@@ -0,0 +1,133 @@
+/* R64 diagnostic counters. EXPERIMENTAL, OFF by default.
+ *
+ * Everything here is compiled only with -DDOOM_R64_DIAG. Without that flag every
+ * R64D_* hook expands to nothing, so performance builds are source-identical to R60
+ * after preprocessing (checked by scripts/lab/check_r64d_inert.py).
+ *
+ * Hooks only COUNT. They never branch the renderer, change a value, touch the VDP,
+ * or alter the tic policy. Counters live in one block in WRAM that can be found in a
+ * RAM dump by its magic (see scripts/lab/r64d_read.py). Do not use FPS from a
+ * diagnostic ROM: the increments cost cycles.
+ */
+#ifndef R64_DIAG_H
+#define R64_DIAG_H
+#include <stdint.h>
+
+#if defined(DOOM_R64_DIAG)
+
+#define R64D_MAGIC 0x52363444UL /* 'R64D' */
+#define R64D_VERSION 1u
+
+enum {
+    R64D_FRAMES,        /* R_RenderPlayerView calls */
+    /* R_AddLine */
+    R64D_AL_CALLS, R64D_AL_REAR, R64D_AL_LEFT, R64D_AL_RIGHT, R64D_AL_ZERO,
+    R64D_AL_CLIPCALLS,  /* segs that reached R_ClipWallSegment (not RF_IGNORE) */
+    R64D_AL_V1_REUSE,   /* v1 equals previous seg's v2 inside the same subsector */
+    R64D_XP_REAR_OK,    /* cross product says rear AND angle test says rear */
+    R64D_XP_FALSE_REAR, /* cross product says rear but angle test says NOT rear */
+    R64D_XP_MISSED_REAR,/* angle test says rear but cross product does not */
+    R64D_XP_SKIP,       /* coordinates out of int32-safe range, not evaluated */
+    /* fragments: R_StoreWallRange calls per seg that reached the clip */
+    R64D_SEG_R0, R64D_SEG_R1, R64D_SEG_R2, R64D_SEG_R3, R64D_SEG_R4P,
+    R64D_SR_CALLS, R64D_SR_COLS, R64D_SEG_COLS, /* SEG_COLS = R_RenderSegLoop iterations */
+    /* BSP */
+    R64D_NODES, R64D_NODES_FULL, R64D_SUBSECTORS, R64D_SUBSECTORS_FULL,
+    R64D_BB_CALLS, R64D_BB_FULL, R64D_BB_FOV, R64D_BB_OCC, R64D_BB_ACCEPT,
+    /* column drawing */
+    R64D_WALL_CALLS, R64D_WALL_DRAWN, R64D_WALL_PIXELS, R64D_WALL_ASM,
+    R64D_WALL_FB_CMAP, R64D_WALL_FB_SHORT,
+    R64D_FLAT_CALLS, R64D_FLAT_DRAWN, R64D_FLAT_PIXELS,
+    /* tics / time (VBlank = 1/60 s, coarse but additive) */
+    R64D_DF_FRAMES, R64D_TICS, R64D_TICS_H0, R64D_TICS_H1, R64D_TICS_H2, R64D_TICS_H3,
+    R64D_TICS_H4, R64D_TICS_H5, R64D_TICS_H6, R64D_TICS_H7P,
+    R64D_VB_LOGIC, R64D_VB_RENDER,
+    R64D_NCOUNTERS
+};
+
+/* state[] slots (not counters) */
+enum { R64D_S_RANGES, R64D_S_PVALID, R64D_S_PX, R64D_S_PY, R64D_S_TIC0, R64D_S_VB0, R64D_S_VB1, R64D_S_N };
+
+typedef struct {
+    uint32_t magic;
+    uint16_t version;
+    uint16_t ncounters;
+    uint32_t state[R64D_S_N];
+    uint32_t c[R64D_NCOUNTERS];
+} r64d_block_t;
+
+extern volatile r64d_block_t r64d; /* defined in r_draw.c */
+
+#define R64D_HIT(id) (r64d.c[(id)]++)
+#define R64D_ADD(id,n) (r64d.c[(id)]+=(uint32_t)(n))
+#define R64D_FRAME() do{ if(r64d.magic!=R64D_MAGIC){ r64d.magic=R64D_MAGIC; r64d.version=R64D_VERSION; \
+    r64d.ncounters=R64D_NCOUNTERS; } R64D_HIT(R64D_FRAMES); }while(0)
+#define R64D_RESET() do{ uint16_t _i; for(_i=0;_i<R64D_NCOUNTERS;++_i) r64d.c[_i]=0; }while(0)
+
+/* solidcol / VIEWWINDOWWIDTH exist only in r_draw.c; these macros are used only there. */
+#define R64D_FULL() (memchr(solidcol,0,VIEWWINDOWWIDTH)==0)
+#define R64D_NODE() do{ R64D_HIT(R64D_NODES); if(R64D_FULL()) R64D_HIT(R64D_NODES_FULL); }while(0)
+#define R64D_SUBSEC() do{ R64D_HIT(R64D_SUBSECTORS); if(R64D_FULL()) R64D_HIT(R64D_SUBSECTORS_FULL); \
+    r64d.state[R64D_S_PVALID]=0; }while(0)
+#define R64D_BBOX() do{ R64D_HIT(R64D_BB_CALLS); if(R64D_FULL()) R64D_HIT(R64D_BB_FULL); }while(0)
+
+/* R_AddLine: vertex reuse candidate (same subsector, previous v2 == this v1) */
+#define R64D_VREUSE(l) do{ \
+    if(r64d.state[R64D_S_PVALID] && (int16_t)r64d.state[R64D_S_PX]==(int16_t)(l)->v1.x \
+       && (int16_t)r64d.state[R64D_S_PY]==(int16_t)(l)->v1.y) R64D_HIT(R64D_AL_V1_REUSE); \
+    r64d.state[R64D_S_PX]=(uint16_t)(l)->v2.x; r64d.state[R64D_S_PY]=(uint16_t)(l)->v2.y; \
+    r64d.state[R64D_S_PVALID]=1; }while(0)
+
+/* Would a cross-product pre-test have agreed with the 16-bit angle back-face test? */
+#define R64D_XPRED(l,span) do{ \
+    int32_t _vx=(int32_t)(viewx>>FRACBITS), _vy=(int32_t)(viewy>>FRACBITS); \
+    int32_t _x1=(int32_t)(l)->v1.x-_vx, _y1=(int32_t)(l)->v1.y-_vy; \
+    int32_t _x2=(int32_t)(l)->v2.x-_vx, _y2=(int32_t)(l)->v2.y-_vy; \
+    if(_x1>32767||_x1<-32767||_y1>32767||_y1<-32767||_x2>32767||_x2<-32767||_y2>32767||_y2<-32767) \
+        R64D_HIT(R64D_XP_SKIP); \
+    else { \
+        uint8_t _pr=((_x1*_y2-_x2*_y1)>0); uint8_t _ar=((span)>=ANG180_16); \
+        if(_pr&&_ar) R64D_HIT(R64D_XP_REAR_OK); \
+        else if(_pr&&!_ar) R64D_HIT(R64D_XP_FALSE_REAR); \
+        else if(!_pr&&_ar) R64D_HIT(R64D_XP_MISSED_REAR); \
+    } }while(0)
+
+/* fragments per seg */
+#define R64D_SEG_BEGIN() (r64d.state[R64D_S_RANGES]=0)
+#define R64D_SR(ncols) do{ R64D_HIT(R64D_SR_CALLS); R64D_ADD(R64D_SR_COLS,(ncols)); r64d.state[R64D_S_RANGES]++; }while(0)
+#define R64D_SEG_END() do{ uint32_t _n=r64d.state[R64D_S_RANGES]; \
+    R64D_HIT(_n==0?R64D_SEG_R0:_n==1?R64D_SEG_R1:_n==2?R64D_SEG_R2:_n==3?R64D_SEG_R3:R64D_SEG_R4P); }while(0)
+
+/* column drawers */
+#define R64D_WALL_DRAWN(npix) do{ R64D_HIT(R64D_WALL_DRAWN); R64D_ADD(R64D_WALL_PIXELS,(npix)); }while(0)
+#define R64D_WALL_FB(colormap,count) do{ if(colormap) R64D_HIT(R64D_WALL_FB_CMAP); else R64D_HIT(R64D_WALL_FB_SHORT); (void)(count); }while(0)
+#define R64D_FLAT_DRAWN(npix) do{ R64D_HIT(R64D_FLAT_DRAWN); R64D_ADD(R64D_FLAT_PIXELS,(npix)); }while(0)
+
+/* tics per rendered frame and VBlanks spent in logic vs render (d_main.c) */
+#define R64D_LOOP_BEGIN(gametic,vbl) do{ r64d.state[R64D_S_TIC0]=(uint32_t)(gametic); r64d.state[R64D_S_VB0]=(uint32_t)(vbl); }while(0)
+#define R64D_LOGIC_END(gametic,vbl) do{ uint32_t _t=(uint32_t)(gametic)-r64d.state[R64D_S_TIC0]; \
+    R64D_ADD(R64D_TICS,_t); R64D_HIT(R64D_TICS_H0+(_t>7u?7u:_t)); \
+    r64d.state[R64D_S_VB1]=(uint32_t)(vbl); R64D_ADD(R64D_VB_LOGIC,r64d.state[R64D_S_VB1]-r64d.state[R64D_S_VB0]); }while(0)
+#define R64D_RENDER_END(vbl) do{ R64D_HIT(R64D_DF_FRAMES); R64D_ADD(R64D_VB_RENDER,(uint32_t)(vbl)-r64d.state[R64D_S_VB1]); }while(0)
+
+#else /* !DOOM_R64_DIAG: every hook vanishes */
+#define R64D_HIT(id) ((void)0)
+#define R64D_ADD(id,n) ((void)0)
+#define R64D_FRAME() ((void)0)
+#define R64D_RESET() ((void)0)
+#define R64D_NODE() ((void)0)
+#define R64D_SUBSEC() ((void)0)
+#define R64D_BBOX() ((void)0)
+#define R64D_VREUSE(l) ((void)0)
+#define R64D_XPRED(l,span) ((void)0)
+#define R64D_SEG_BEGIN() ((void)0)
+#define R64D_SR(ncols) ((void)0)
+#define R64D_SEG_END() ((void)0)
+#define R64D_WALL_DRAWN(npix) ((void)0)
+#define R64D_WALL_FB(colormap,count) ((void)0)
+#define R64D_FLAT_DRAWN(npix) ((void)0)
+#define R64D_LOOP_BEGIN(gametic,vbl) ((void)0)
+#define R64D_LOGIC_END(gametic,vbl) ((void)0)
+#define R64D_RENDER_END(vbl) ((void)0)
+#endif
+#endif
