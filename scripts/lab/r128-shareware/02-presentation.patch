+static void R35_SetNativeTextColor(bool visible)
+{
+    if (visible == r35_white_font)
+        return;
+    /* Native glyphs use PAL0 color 15. Restore the supplied art color
+       once the overlay is gone. */
+    const u16 color = visible ? 0x0EEE : r35_native4[r35_native_active].palette[15];
+    const u16 sr = R22_Lock();
+    if (r35_native_active == R35_TITLE)
+    {
+        for (u16 i = 0; i < sizeof(r35_title_menu_tiles) / sizeof(r35_title_menu_tiles[0]); ++i)
+        {
+            const u16 tile = r35_title_menu_tiles[i];
+            const u8 *pattern = visible ? r35_title_menu_patterns[i] : r30_title_pack + 32UL * tile;
+            VDP_loadTileData((const u32 *)(const void *)pattern, 16 + tile, 1, CPU);
+        }
+    }
+    PAL_setColor(15, color);
+    R22_Unlock(sr);
+    r35_white_font = visible;
+}
