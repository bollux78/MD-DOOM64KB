 };
 static int16_t r35_native_active=-1;
 static bool r35_white_font;
+static bool r35_title_menu_shadow;
+static u16 r35_title_menu_sprite_count;
+
+enum { R35_BOX_LEFT=11, R35_BOX_TOP=7, R35_BOX_RIGHT=27, R35_BOX_BOTTOM=16 };
+
+static void R35_ClearTitleMenuSprites(void)
+{
+    volatile u32 *ctrl=(volatile u32 *)0xC00004;
+    volatile u32 *data=(volatile u32 *)0xC00000;
+    *ctrl=VDP_WRITE_VRAM_ADDR(VDP_SPRITE_TABLE);
+    *data=0;
+    *data=0;
+}
+
+static void R35_BeginTitleMenu(void)
+{
+    extern boolean M_IsMainMenuVisible(void);
+    const bool desired = r35_native_active == R35_TITLE &&
+        _g_gamestate == GS_DEMOSCREEN && M_IsMainMenuVisible();
+    r35_title_menu_sprite_count = 0;
+    if (desired == r35_title_menu_shadow)
+        return;
+
+    const u16 sr = R22_Lock();
+    u16 row[40];
+    for (u16 y = 0; y < 28; ++y)
+    {
+        for (u16 x = 0; x < 40; ++x)
+        {
+            const bool inside = x >= R35_BOX_LEFT && x < R35_BOX_RIGHT &&
+                y >= R35_BOX_TOP && y < R35_BOX_BOTTOM;
+            row[x] = (r30_title_map[40u*y+x] + 16u) | (desired && !inside ? 0x8000u : 0);
+        }
+        VDP_setTileMapDataRect(BG_A,row,0,y,40,1,40,CPU);
+    }
+    VDP_setAutoInc(2);
+    R35_ClearTitleMenuSprites();
+    VDP_setHilightShadow(desired);
+    R22_Unlock(sr);
+
+    R40B_ResetNativeText();
+    r22_overlay_dirty = 0;
+    r35_title_menu_shadow = desired;
+}
+
+static bool R35_DrawTitleMenuSprites(u16 x,u16 y,const char *text)
+{
+    if (!r35_title_menu_shadow)
+        return false;
+
+    const u16 sr = R22_Lock();
+    volatile u32 *ctrl=(volatile u32 *)0xC00004;
+    volatile u16 *data=(volatile u16 *)0xC00000;
+    VDP_setAutoInc(2);
+    *ctrl=VDP_WRITE_VRAM_ADDR(VDP_SPRITE_TABLE+8u*r35_title_menu_sprite_count);
+    for (; *text && x < R40B_TEXT_W && r35_title_menu_sprite_count < 80u; ++text, ++x)
+    {
+        const u8 c = (u8)*text;
+        if (c <= 32u || c > 127u)
+            continue;
+        *data = 128u + 8u*y;
+        *data = ++r35_title_menu_sprite_count;
+        *data = 0x8000u | (TILE_FONT_INDEX+c-32u);
+        *data = 128u + 8u*x;
+    }
+    R22_Unlock(sr);
+    return true;
+}
+
+static bool R35_EndTitleMenu(void)
+{
+    if (!r35_title_menu_shadow)
+        return false;
+
+    const u16 sr = R22_Lock();
+    if (r35_title_menu_sprite_count)
+    {
+        volatile u32 *ctrl=(volatile u32 *)0xC00004;
+        volatile u16 *data=(volatile u16 *)0xC00000;
+        *ctrl=VDP_WRITE_VRAM_ADDR(VDP_SPRITE_TABLE+8u*(r35_title_menu_sprite_count-1u)+2u);
+        *data=0;
+    }
+    else
+        R35_ClearTitleMenuSprites();
+    R22_Unlock(sr);
+    return true;
+}
