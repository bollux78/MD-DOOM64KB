@@ -0,0 +1,146 @@
+#if NPAL > 1
+        .text
+        .globl R_PaletteSpan
+/* ABI arguments are 32-bit slots, with unsigned 16-bit values in their low words.
+ * Native scalers draw first. Only fragments whose tile belongs to another
+ * palette need pixel remapping. All matching fragments retain the native path. */
+R_PaletteSpan:
+        movem.l %d2-%d7/%a2-%a4,-(%sp)
+        move.w  42(%sp),%d2                 /* y0 */
+        move.w  46(%sp),%d3                 /* rows */
+        move.w  50(%sp),%d4                 /* source palette */
+        addq.l  #1,pal_spans
+        tst.w   %d3
+        beq     .Lpal_done
+        moveq   #0,%d0
+        move.w  54(%sp),%d0                 /* logical column -> tile column */
+        mulu.w  r_colb,%d0
+        lsr.w   #2,%d0
+        move.w  %d0,%d1
+        lsl.w   #2,%d1
+        lea     palette_claimed,%a0
+        adda.w  %d1,%a0
+        move.w  %d0,%d1
+        add.w   %d1,%d1
+#if NPAL == 3
+        add.w   %d0,%d1
+#endif
+        add.w   %d4,%d1
+        lsl.w   #2,%d1
+        lea     palette_owned,%a1
+        adda.w  %d1,%a1
+        move.w  %d2,%d5
+        add.w   %d3,%d5
+        addq.w  #7,%d5
+        lsr.w   #3,%d5                     /* last covered tile + 1 */
+        lsl.w   #2,%d5
+        move.w  %d2,%d6
+        lsr.w   #3,%d6
+        lsl.w   #2,%d6
+        lea     palette_prefix(%pc),%a4
+        move.l  0(%a4,%d5.w),%d7
+        move.l  0(%a4,%d6.w),%d1
+        eor.l   %d1,%d7                    /* mask of tile rows touched by this span */
+        move.l  (%a0),%d5
+        and.l   %d7,%d5
+        move.l  (%a1),%d1
+        not.l   %d1
+        and.l   %d1,%d5                    /* bits owned by another palette */
+        move.l  (%a0),%d6
+        not.l   %d6
+        and.l   %d7,%d6                    /* bits not claimed yet */
+        beq.s   .Lpal_check_conflict
+        or.l    %d6,(%a0)
+        or.l    %d6,(%a1)
+        move.w  r_vh,%d1
+        lsr.w   #3,%d1
+        mulu.w  %d1,%d0
+        lea     tilepal,%a2
+        adda.w  %d0,%a2
+.Lpal_claim_mask:
+        btst    #0,%d6
+        beq.s   1f
+        move.b  %d4,(%a2)
+1:      addq.l  #1,%a2
+        lsr.l   #1,%d6
+        bne.s   .Lpal_claim_mask
+.Lpal_check_conflict:
+        tst.l   %d5
+        beq     .Lpal_done                  /* common case: no per-tile scan */
+        moveq   #0,%d0
+        move.w  54(%sp),%d0
+        add.w   %d0,%d0
+        lea     r_colofs,%a0
+        movea.l rfb,%a2
+        adda.w  0(%a0,%d0.w),%a2
+        move.w  %d2,%d1
+        lsl.w   #2,%d1
+        adda.w  %d1,%a2
+        lsr.w   #1,%d0
+        mulu.w  r_colb,%d0
+        lsr.w   #2,%d0
+        move.w  r_vh,%d1
+        lsr.w   #3,%d1
+        mulu.w  %d1,%d0
+        move.w  %d2,%d1
+        lsr.w   #3,%d1
+        add.w   %d1,%d0
+        lea     tilepal,%a0
+        adda.w  %d0,%a0
+.Lpal_tile:
+        moveq   #8,%d5
+        move.w  %d2,%d0
+        andi.w  #7,%d0
+        sub.w   %d0,%d5
+        cmp.w   %d3,%d5
+        bls.s   1f
+        move.w  %d3,%d5
+1:      moveq   #0,%d0
+        move.b  (%a0),%d0
+        cmp.w   %d4,%d0
+        beq.s   .Lpal_next
+        move.w  %d4,%d1
+        add.w   %d1,%d1
+#if NPAL == 3
+        add.w   %d4,%d1
+#endif
+        add.w   %d0,%d1
+        lsl.w   #8,%d1
+        lea     pal_remap+128,%a1
+        adda.w  %d1,%a1
+        add.l   %d5,pal_conflict_pixels
+        movea.l %a2,%a3
+        move.w  %d5,%d1
+        subq.w  #1,%d1
+        cmpi.w  #2,r_colb
+        beq.s   .Lpal_words
+.Lpal_bytes:
+        move.b  (%a3),%d0
+        ext.w   %d0
+        move.b  0(%a1,%d0.w),(%a3)
+        addq.l  #4,%a3
+        dbra    %d1,.Lpal_bytes
+        bra.s   .Lpal_next
+.Lpal_words:
+        move.b  (%a3),%d0
+        ext.w   %d0
+        move.b  0(%a1,%d0.w),%d0
+        move.b  %d0,(%a3)
+        move.b  %d0,1(%a3)
+        addq.l  #4,%a3
+        dbra    %d1,.Lpal_words
+.Lpal_next:
+        addq.l  #1,%a0
+        move.w  %d5,%d0
+        lsl.w   #2,%d0
+        adda.w  %d0,%a2
+        add.w   %d5,%d2
+        sub.w   %d5,%d3
+        bne     .Lpal_tile
+.Lpal_done:
+        movem.l (%sp)+,%d2-%d7/%a2-%a4
+        rts
+        .even
+palette_prefix:
+        .long 0,1,3,7,15,31,63,127,255,511,1023,2047,4095,8191,16383,32767,65535,131071,262143
+#endif
diff --git a/experiments/DREAD_MD/d01/tools/merge_ui_palette.py b/experiments/DREAD_MD/d01/tools/merge_ui_palette.py
new file mode 100644
--- /dev/null
+++ b/experiments/DREAD_MD/d01/tools/merge_ui_palette.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Merge the HUD and face; optionally map weapon pixels into that same CRAM line."""
+import re
+import sys
+from pathlib import Path
+from gen_hud import single_palette
+
+header, weapon = map(Path, sys.argv[1:3])
+count = int(sys.argv[3])
+palette = single_palette(header, free_slots=5, protect=(15,))
+if count == 3:
+    source = weapon.read_text()
+    match = re.search(r'weap_pal\[16\] = \{([^}]*)\}', source)
+    original = [int(v, 16) for v in re.findall(r'0x([0-9a-fA-F]+)', match[1])]
+    def rgb(word):
+        return ((word >> 1) & 7, (word >> 5) & 7, (word >> 9) & 7)
+    def distance(a, b):
+        return sum(w * (x-y)**2 for w, x, y in zip((2, 4, 3), rgb(a), rgb(b)))
+    lookup = [0] + [min(range(1, 16), key=lambda j: distance(c, palette[j])) for c in original[1:]]
+    data = re.search(r'(weap_data\[\d+\] = \{)(.*?)(\};)', source, re.S)
+    def remap(match):
+        word = int(match[1], 16)
+        return '0x%08X' % sum(lookup[(word >> (4*i)) & 15] << (4*i) for i in range(8))
+    source = source[:data.start(2)] + re.sub(r'0x([0-9a-fA-F]{8})', remap, data[2]) + source[data.end(2):]
+    weapon.write_text(source)
+print('UI uses %d palette(s), world uses %d' % (4-count, count))
