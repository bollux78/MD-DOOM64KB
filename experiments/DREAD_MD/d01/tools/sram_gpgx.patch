diff --git a/core/cart_hw/sram.c b/core/cart_hw/sram.c
index b4d7d06..a7c6d9b 100644
--- a/core/cart_hw/sram.c
+++ b/core/cart_hw/sram.c
@@ -257,22 +257,38 @@ void sram_init(void)
   }
 }
 
+unsigned int retro_sram_block;
+unsigned long long retro_sram_counts[4];
 unsigned int sram_read_byte(unsigned int address)
 {
+  retro_sram_counts[0]++;
+  if (retro_sram_block == 1 || (retro_sram_block == 2 && !(address & 1))) return 0xff;
+
   return sram.sram[address & 0xffff];
 }
 
 unsigned int sram_read_word(unsigned int address)
 {
+  retro_sram_counts[1]++;
+  if (retro_sram_block == 1) return 0xffff;
+  if (retro_sram_block == 2) return 0xff00 | sram.sram[(address | 1) & 0xffff];
+
   return READ_WORD(sram.sram, address & 0xfffe);
 }
 
 void sram_write_byte(unsigned int address, unsigned int data)
 {
+  retro_sram_counts[2]++;
+  if (retro_sram_block == 1 || (retro_sram_block == 2 && !(address & 1))) return;
+
   sram.sram[address & 0xffff] = data;
 }
 
 void sram_write_word(unsigned int address, unsigned int data)
 {
+  retro_sram_counts[3]++;
+  if (retro_sram_block == 1) return;
+  if (retro_sram_block == 2) { sram.sram[(address | 1) & 0xffff] = data; return; }
+
   WRITE_WORD(sram.sram, address & 0xfffe, data);
 }
